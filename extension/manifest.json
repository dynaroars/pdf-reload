{
  "manifest_version": 2,
  "name": "Local PDF Reload",
  "version": "0.1.0",
  "description": "Reload watched local PDFs only when their contents change, using Firefox's built-in viewer.",
  "browser_specific_settings": {
    "gecko": {
      "id": "pdf-reload@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["tabs", "nativeMessaging"],
  "background": { "scripts": ["background.js"] },
  "options_ui": { "page": "setup.html" },
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "browser_action": {
    "default_title": "Watch this local PDF",
    "default_icon": "icon.svg"
  }
}
